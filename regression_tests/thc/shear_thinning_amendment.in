#Description: 1D THC shear-thinning polymer + first-order decay + GIRT
#             AMENDMENT filtration. Reduced from the CompFlow comparison
#             deck (scratch/dvz/particle-delivery/compare_compflow_thc).

SIMULATION
  SIMULATION_TYPE SUBSURFACE
  PROCESS_MODELS
    SUBSURFACE_FLOW flow
      MODE THC
      OPTIONS
        SHEAR_THINNING_FLUID
        SOLUTE_DECAY_RATE_CONSTANT 1.15 1/week
        LIQUID_HEAT_CAPACITY 4184.d0 J/kg-C
        SOLID_HEAT_CAPACITY 800.d0 J/kg-C
        SOLID_DENSITY 2650.d0 kg/m^3
        THERMAL_CONDUCTIVITY_SOLID 3.d0 W/m-C
      /
    /
    SUBSURFACE_TRANSPORT transport
      MODE GIRT
    /
    PARAMETER viscosity
      PARAMETER_NAME Viscosity
      WHEN_TO_UPDATE AFTER_FLOW
    /
  /
END

SUBSURFACE

NUMERICAL_METHODS FLOW
  TIMESTEPPER
    CONC_CHANGE_TS_GOVERNOR 1.d3
  /
  NEWTON_SOLVER
    MAX_ALLOW_LIQ_PRES_CHANGE_NI 1.d0
  /
  LINEAR_SOLVER
    SOLVER DIRECT
  /
END

NUMERICAL_METHODS TRANSPORT
END

PARAMETER
  NAME Viscosity
  VARIABLE LIQUID_VISCOSITY
END

REGRESSION
  CELL_IDS
    2
    5
    8
  /
END

GRID
  TYPE STRUCTURED
  NXYZ 10 1 1
  BOUNDS
    0.d0 0.d0 0.d0
    10.d0 1.d0 1.d0
  /
END

FLUID_PROPERTY
  DIFFUSION_COEFFICIENT 1.d-9
END

MATERIAL_PROPERTY soil1
  ID 1
  POROSITY 0.25d0
  TORTUOSITY 1.d0
  PERMEABILITY
    PERM_ISO 1.d-11
  /
  CHARACTERISTIC_CURVES cc1
  MEAN_SOIL_GRAIN_SIZE 966.d-6
END

CHARACTERISTIC_CURVES cc1
  SATURATION_FUNCTION VAN_GENUCHTEN
    ALPHA 1.d-4
    M 0.5d0
    LIQUID_RESIDUAL_SATURATION 0.1d0
  /
  PERMEABILITY_FUNCTION MUALEM_VG_LIQ
    M 0.5d0
    LIQUID_RESIDUAL_SATURATION 0.1d0
  /
END

CHEMISTRY
  PRIMARY_SPECIES
    Particle_aq
    Br-
  /
  IMMOBILE_SPECIES
    Particle_im
  /
  REACTION_SANDBOX
    AMENDMENT
      PARTICLE_NAME_AQ Particle_aq
      PARTICLE_NAME_IM Particle_im
      ATTACHMENT_MODEL FILTRATION
        PARTICLE_DIAMETER 10.d-7
        HAMAKER_CONSTANT 5.d-21
        PARTICLE_DENSITY 2000.0
        ATTACHMENT_EFFICIENCY 0.001
      /
      DETACHMENT_MODEL CONSTANT
        RATE 1.d-4 1/h
      /
    /
  /
  ACTIVITY_COEFFICIENTS OFF
  OUTPUT
    ALL
    TOTAL
  /
END

OUTPUT
  TIMES d 0.1
  FORMAT TECPLOT POINT
  VARIABLES
    LIQUID_PRESSURE
    LIQUID_VISCOSITY
    SOLUTE_CONCENTRATION
  /
END

TIME
  FINAL_TIME 0.1d0 d
  INITIAL_TIMESTEP_SIZE 0.02d0 d
  MAXIMUM_TIMESTEP_SIZE 0.05d0 d
END

REGION all
  COORDINATES
    0.d0 0.d0 0.d0
    10.d0 1.d0 1.d0
  /
END

REGION west
  FACE WEST
  COORDINATES
    0.d0 0.d0 0.d0
    0.d0 1.d0 1.d0
  /
END

REGION east
  FACE EAST
  COORDINATES
    10.d0 0.d0 0.d0
    10.d0 1.d0 1.d0
  /
END

FLOW_CONDITION initial
  TYPE
    LIQUID_PRESSURE DIRICHLET
    TEMPERATURE DIRICHLET
    CONCENTRATION DIRICHLET
  /
  LIQUID_PRESSURE 101325.d0
  TEMPERATURE 25.d0
  CONCENTRATION 1.d-10
END

FLOW_CONDITION inlet
  TYPE
    LIQUID_FLUX NEUMANN
    TEMPERATURE DIRICHLET
    CONCENTRATION DIRICHLET
  /
  LIQUID_FLUX 10.d0 m/d
  TEMPERATURE 25.d0
  CONCENTRATION 1000.d0
END

FLOW_CONDITION outlet
  TYPE
    LIQUID_PRESSURE DIRICHLET
    TEMPERATURE ZERO_GRADIENT
    CONCENTRATION ZERO_GRADIENT
  /
  LIQUID_PRESSURE 101325.d0
  TEMPERATURE 25.d0
  CONCENTRATION 1.d-10
END

TRANSPORT_CONDITION initial
  TYPE DIRICHLET_ZERO_GRADIENT
  CONSTRAINT_LIST
    0.d0 initial
  /
END

TRANSPORT_CONDITION inlet
  TYPE DIRICHLET
  CONSTRAINT_LIST
    0.d0 inlet
  /
END

TRANSPORT_CONDITION outlet
  TYPE ZERO_GRADIENT
  CONSTRAINT_LIST
    0.d0 initial
  /
END

CONSTRAINT initial
  CONCENTRATIONS
    Particle_aq 1.d-10 T
    Br- 1.d-10 T
  /
  IMMOBILE
    Particle_im 1.d-10
  /
END

CONSTRAINT inlet
  CONCENTRATIONS
    Particle_aq 0.06788d0 T
    Br- 7.259d-3 T
  /
  IMMOBILE
    Particle_im 1.d-10
  /
END

INITIAL_CONDITION
  FLOW_CONDITION initial
  TRANSPORT_CONDITION initial
  REGION all
END

BOUNDARY_CONDITION inlet
  FLOW_CONDITION inlet
  TRANSPORT_CONDITION inlet
  REGION west
END

BOUNDARY_CONDITION outlet
  FLOW_CONDITION outlet
  TRANSPORT_CONDITION outlet
  REGION east
END

STRATA
  REGION all
  MATERIAL soil1
END

END_SUBSURFACE
