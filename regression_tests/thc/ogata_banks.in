#Description: Ogata-Banks (1961) benchmark: 1D advection-dispersion of a
#             solute step at constant Darcy flux, isothermal, pure-water EOS
#             so C is inert in rho/mu and transport is linear.  Compare with
#             src/python/analytical/thc_ogata_banks_check.py

SIMULATION
  SIMULATION_TYPE SUBSURFACE
  PROCESS_MODELS
    SUBSURFACE_FLOW flow
      MODE THC
      OPTIONS
        LIQUID_HEAT_CAPACITY 4184.d0 J/kg-C
        SOLID_HEAT_CAPACITY 800.d0 J/kg-C
        SOLID_DENSITY 2650.d0 kg/m^3
        THERMAL_CONDUCTIVITY_SOLID 3.d0 W/m-C
      /
    /
  /
END

SUBSURFACE

#=========================== numerical methods ================================
NUMERICAL_METHODS FLOW
  NEWTON_SOLVER
    MAX_ALLOW_LIQ_PRES_CHANGE_NI 1.d0
  /
  LINEAR_SOLVER
    SOLVER DIRECT
  /
END

#=========================== regression =======================================
REGRESSION
  CELL_IDS
    20
    60
    100
    140
    180
  /
END

#=========================== discretization ===================================
GRID
  TYPE STRUCTURED
  NXYZ 200 1 1
  BOUNDS
    0.d0 0.d0 0.d0
    10.d0 1.d0 1.d0
  /
END

#=========================== fluid properties =================================
FLUID_PROPERTY
  DIFFUSION_COEFFICIENT 1.d-9
END

#=========================== material properties ==============================
MATERIAL_PROPERTY soil1
  ID 1
  POROSITY 0.25d0
  TORTUOSITY 1.d0
  LONGITUDINAL_DISPERSIVITY 0.5d0
  PERMEABILITY
    PERM_ISO 1.d-10
  /
  CHARACTERISTIC_CURVES cc1
END

#=========================== characteristic curves ============================
CHARACTERISTIC_CURVES cc1
  SATURATION_FUNCTION VAN_GENUCHTEN
    ALPHA 1.d-4
    M 0.5d0
    LIQUID_RESIDUAL_SATURATION 0.1d0
  /
  PERMEABILITY_FUNCTION MUALEM_VG_LIQ
    M 0.5d0
    LIQUID_RESIDUAL_SATURATION 0.1d0
  /
END

#=========================== output options ===================================
OUTPUT
  TIMES d 1.25
  FORMAT TECPLOT POINT
  VARIABLES
    LIQUID_PRESSURE
    SOLUTE_CONCENTRATION
  /
END

#=========================== times ============================================
TIME
  FINAL_TIME 1.25d0 d
  INITIAL_TIMESTEP_SIZE 1.d-3 d
  MAXIMUM_TIMESTEP_SIZE 1.d-2 d
END

#=========================== regions ==========================================
REGION all
  COORDINATES
    0.d0 0.d0 0.d0
    10.d0 1.d0 1.d0
  /
END

REGION west
  FACE WEST
  COORDINATES
    0.d0 0.d0 0.d0
    0.d0 1.d0 1.d0
  /
END

REGION east
  FACE EAST
  COORDINATES
    10.d0 0.d0 0.d0
    10.d0 1.d0 1.d0
  /
END

#=========================== flow conditions ==================================
FLOW_CONDITION initial
  TYPE
    LIQUID_PRESSURE DIRICHLET
    TEMPERATURE DIRICHLET
    CONCENTRATION DIRICHLET
  /
  LIQUID_PRESSURE 101325.d0
  TEMPERATURE 25.d0
  CONCENTRATION 0.d0
END

FLOW_CONDITION inlet
  TYPE
    LIQUID_FLUX NEUMANN
    TEMPERATURE DIRICHLET
    CONCENTRATION DIRICHLET
  /
  LIQUID_FLUX 1.d0 m/d
  TEMPERATURE 25.d0
  CONCENTRATION 1.d-3
END

FLOW_CONDITION outlet
  TYPE
    LIQUID_PRESSURE DIRICHLET
    TEMPERATURE ZERO_GRADIENT
    CONCENTRATION ZERO_GRADIENT
  /
  LIQUID_PRESSURE 101325.d0
  TEMPERATURE 25.d0
  CONCENTRATION 0.d0
END

#=========================== condition couplers ===============================
INITIAL_CONDITION
  FLOW_CONDITION initial
  REGION all
END

BOUNDARY_CONDITION inlet
  FLOW_CONDITION inlet
  REGION west
END

BOUNDARY_CONDITION outlet
  FLOW_CONDITION outlet
  REGION east
END

#=========================== stratigraphy couplers ============================
STRATA
  REGION all
  MATERIAL soil1
END

END_SUBSURFACE
