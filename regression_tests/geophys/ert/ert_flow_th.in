#Description: 3D Geophysics Electrical Resistivity Tomography problem coupled to TH flow

SIMULATION
  SIMULATION_TYPE SUBSURFACE
  PROCESS_MODELS
    SUBSURFACE_FLOW flow
      MODE TH
    /
    SUBSURFACE_GEOPHYSICS geophysics
      MODE ERT
      OPTIONS
        COMPUTE_JACOBIAN
        SURVEY_TIMES h 0.d0 6.d0 12.d0 24.d0
        OUTPUT_ALL_SURVEYS
      /
    /
  /
END

SUBSURFACE

EXTERNAL_FILE ert_flow_th.txt

#=========================== regression =======================================
REGRESSION
  CELLS_PER_PROCESS 3
  CELL_IDS
    1
    60
    93
    120
  /
  VARIABLES
    LIQUID_PRESSURE
    ELECTRICAL_CONDUCTIVITY
    TEMPERATURE
    ELECTRICAL_POTENTIAL 2
    ELECTRICAL_JACOBIAN 1
  /
END

#=========================== material properties ==============================
MATERIAL_PROPERTY soil1
  ID 1
  ARCHIE_CEMENTATION_EXPONENT 1.9d0
  ARCHIE_SATURATION_EXPONENT 2.d0
  ARCHIE_TORTUOSITY_CONSTANT 1.d0
  SURFACE_ELECTRICAL_CONDUCTIVITY 0.0002d0
  POROSITY 0.25d0
  TORTUOSITY 0.5d0
  ROCK_DENSITY 2650.d0
  SPECIFIC_HEAT 1000.d0
  THERMAL_CONDUCTIVITY_DRY 0.5d0
  THERMAL_CONDUCTIVITY_WET 2.d0
  PERMEABILITY
    PERM_ISO 1.d-12
  /
  CHARACTERISTIC_CURVES cc1
END

END_SUBSURFACE
