#Description: 3D ERT forward model on an explicit unstructured copy of the ert grid, for ert_inversion_explicit-np2

SIMULATION
  SIMULATION_TYPE SUBSURFACE
  PROCESS_MODELS
    SUBSURFACE_GEOPHYSICS geophysics
      MODE ERT
      OPTIONS
        COMPUTE_JACOBIAN
        OUTPUT_ALL_SURVEYS
      /
    /
  /
END

SUBSURFACE

#=========================== numerical methods ================================
NUMERICAL_METHODS GEOPHYSICS
  LINEAR_SOLVER
    SOLVER BCGS
    PC_TYPE BLOCK_JACOBI
    ATOL 1.d-30
    RTOL 1.d-13
  /
END

#=========================== regression =======================================
REGRESSION
  CELLS_PER_PROCESS 3
  CELL_IDS
    29
  /
  VARIABLES
    ELECTRICAL_CONDUCTIVITY
    ELECTRICAL_POTENTIAL 2
    ELECTRICAL_JACOBIAN 1
  /
END

#=========================== Geophysics survey  ================================
SURVEY
  FILE_NAME ert_explicit.srv
  FORMAT E4D_SRV
END  

#=========================== Output options ==-================================
OUTPUT
  FORMAT HDF5
  VARIABLES
    ELECTRICAL_CONDUCTIVITY
  /  
END

#=========================== discretization ===================================
GRID
  TYPE UNSTRUCTURED_EXPLICIT ert_explicit.uge
END

#=========================== material properties ==============================
MATERIAL_PROPERTY soil1
  ID 1
  ELECTRICAL_CONDUCTIVITY 0.1d0
END

#=========================== regions ==========================================
REGION all
  INFINITE
END

REGION top1
  FILE ert_explicit_top1.ex
END

REGION top2
  FILE ert_explicit_top2.ex
END

REGION west
  FILE ert_explicit_west.ex
END

REGION east
  FILE ert_explicit_east.ex
END

REGION south
  FILE ert_explicit_south.ex
END

REGION north
  FILE ert_explicit_north.ex
END


#=========================== times ============================================
TIME
  FINAL_TIME 1.d0 d
  INITIAL_TIMESTEP_SIZE 1.d0 h
  MAXIMUM_TIMESTEP_SIZE 5.d0 h
END

#=========================== geophyscs conditions =============================
GEOPHYSICS_CONDITION boundary_potential
  TYPE DIRICHLET
END

GEOPHYSICS_CONDITION zero_flux
  TYPE ZERO_GRADIENT
END

#=========================== condition couplers ===============================
INITIAL_CONDITION
  GEOPHYSICS_CONDITION boundary_potential
  REGION all
END

BOUNDARY_CONDITION top_bc1
  GEOPHYSICS_CONDITION boundary_potential
  REGION top1
END


BOUNDARY_CONDITION top_bc2
  GEOPHYSICS_CONDITION boundary_potential
  REGION top2
END

BOUNDARY_CONDITION east_bc
  GEOPHYSICS_CONDITION boundary_potential
  REGION east
END

BOUNDARY_CONDITION west_bc
  GEOPHYSICS_CONDITION boundary_potential
  REGION west
END

BOUNDARY_CONDITION south_bc
  GEOPHYSICS_CONDITION boundary_potential
  REGION south
END

BOUNDARY_CONDITION north_bc
  GEOPHYSICS_CONDITION boundary_potential
  REGION north
END

#=========================== stratigraphy couplers ============================
STRATA
  REGION all
  MATERIAL soil1
END

END_SUBSURFACE
